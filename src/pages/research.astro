<style>.page{max-width:760px;padding:95px 0 130px}.page h1{font:400 51px var(--serif);margin:22px 0 25px}.page>p:nth-of-type(2){font:16px/2 'Noto Serif SC',serif;color:var(--secondary);margin-bottom:65px}.empty{border-top:1px solid var(--border);padding:25px 0 35px}.empty span{color:var(--red);font:11px var(--sans);letter-spacing:.1em}.empty p{font:18px var(--serif);color:var(--secondary)}@media(max-width:680px){.page{padding:55px 0 85px}.page h1{font-size:38px}}</style>
