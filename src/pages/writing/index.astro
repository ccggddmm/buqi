---
import Site from '../../layouts/Site.astro';
import { getPosts, sectionNames, postHref } from '../../lib/posts';
const posts = await getPosts();
const sections = ['all','engineering','essays','notes'] as const;
const labels = {all:'全部', ...sectionNames};
---
<Site title="Writing · 不器">
<section class="head"><p class="eyebrow">WRITING / 文字</p><h1>文字与思考</h1><p>关于人工智能、文学、哲学，以及那些仍在形成中的问题。</p></section>
<div class="filters" aria-label="文章分类">{sections.map((s)=><button data-filter={s} class:list={['filter',{selected:s==='all'}]}>{labels[s]}</button>)}</div>
<ul class="article-list">{posts.map(p=><li class="article-item" data-section={p.data.section}><div><span class="tag">{sectionNames[p.data.section]}</span><h2 class="article-title"><a href={postHref(p.id)}>{p.data.title}</a></h2><p>{p.data.description}</p><div class="tags">{p.data.tags.map(t=><span class="pill">#{t}</span>)}</div></div><time class="article-date">{p.data.date.toISOString().slice(0,10)}</time></li>)}</ul>
<script>
const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
buttons.forEach(button => button.addEventListener('click', () => {
 const current=button.dataset.filter;
 buttons.forEach(b=>b.classList.toggle('selected',b===button));
 document.querySelectorAll<HTMLElement>('[data-section]').forEach(item=>{ item.hidden = current!=='all' && item.dataset.section!==current; });
}));
</script>
</Site>
<style>.head{padding:75px 0 55px}.head h1{font:400 54px var(--serif);margin:16px 0}.head>p:last-child{font:16px/1.9 'Noto Serif SC',serif;color:var(--secondary)}.filters{display:flex;gap:24px;margin:15px 0 27px;flex-wrap:wrap}.filter{appearance:none;background:none;border:0;padding:6px 0 10px;color:var(--secondary);font:13px var(--sans);cursor:pointer;border-bottom:1px solid transparent}.filter.selected{color:var(--red);border-bottom-color:var(--red)}.tags{margin-top:12px}.article-list{margin-bottom:85px}.article-item[hidden]{display:none}@media(max-width:680px){.head{padding:50px 0 38px}.head h1{font-size:39px}.filters{gap:17px}}</style>
