---
interface Props { title?: string; description?: string; }
const { title = '不器 · BUQI', description = '思考技术，也思考技术之外的人与世界。' } = Astro.props;
const current = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const analyticsSite = import.meta.env.PUBLIC_GOATCOUNTER_SITE?.trim();
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="theme-color" content="#f7f5ef" />
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title="不器 RSS" href={`${base}rss.xml`} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Noto+Serif+SC:wght@400;500;600&display=swap" rel="stylesheet" />
<title>{title}</title>
{import.meta.env.PROD && analyticsSite && /^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$/.test(analyticsSite) && (
  <script is:inline async src="https://gc.zgo.at/count.js" data-goatcounter={`https://${analyticsSite}.goatcounter.com/count`}></script>
)}
</head>
<body>
<div class="frame">
<header class="site-header">
  <a class="brand" href={base} aria-label="不器 · 首页">不器<span class="brand-roman">BU QI</span></a>
  <nav aria-label="主导航">
    <a class:list={[{'active': current.startsWith(`${base}writing`)}]} href={`${base}writing/`}>Writing</a>
    <a class:list={[{'active': current.startsWith(`${base}about`)}]} href={`${base}about/`}>About</a>
  </nav>
</header>
<main><slot /></main>
<footer class="footer"><span>不器 <span class="muted">/ 思而不止</span></span><span>© {new Date().getFullYear()} · <a href={`${base}rss.xml`}>RSS</a> · Built with Astro</span></footer>
</div>
</body>
</html>
<style is:global>
@import url('https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css');
:root{--paper:#f7f5ef;--ink:#262822;--secondary:#777970;--border:#d9d9ce;--red:#a64739;--serif:'Newsreader','Noto Serif SC',Georgia,serif;--sans:'DM Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}a:hover{color:var(--red)}.frame{max-width:1080px;margin:0 auto;padding:0 46px}.site-header{height:100px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--border)}.brand{font-family:'Noto Serif SC',serif;font-size:24px;letter-spacing:.22em;font-weight:600;display:flex;align-items:baseline;gap:13px}.brand-roman{font:500 10px var(--sans);letter-spacing:.22em;color:var(--secondary)}nav{display:flex;gap:33px}nav a{font-size:12px;letter-spacing:.05em;color:#595c54}nav a.active{color:var(--red)}.footer{border-top:1px solid var(--border);padding:29px 0 44px;display:flex;justify-content:space-between;gap:16px;color:var(--secondary);font-size:12px}.muted{color:var(--secondary)}.eyebrow{font-size:11px;letter-spacing:.18em;color:var(--red);text-transform:uppercase;font-weight:600}.section-heading{font-family:var(--serif);font-weight:400;font-size:32px;letter-spacing:-.02em}.article-list{list-style:none;margin:0;padding:0}.article-item{padding:26px 0;border-top:1px solid var(--border);display:grid;grid-template-columns:1fr auto;gap:20px}.article-title{font-family:var(--serif);font-size:25px;font-weight:400;line-height:1.35;margin:8px 0}.article-item p{font-size:13px;color:var(--secondary);line-height:1.9;max-width:680px;margin:0}.article-date{font-size:11px;color:var(--secondary);white-space:nowrap;margin-top:4px}.tag{font:500 10px var(--sans);letter-spacing:.12em;text-transform:uppercase;color:var(--red)}.pill{display:inline-block;margin-right:8px;color:#80837a;font-size:12px}::selection{background:#e0d9c7}
@media(max-width:680px){.frame{padding:0 21px}.site-header{height:78px}.brand{font-size:21px;gap:8px}.brand-roman{font-size:9px}nav{gap:17px}nav a{font-size:11px}.footer{flex-direction:column}.article-title{font-size:22px}}
</style>
